amends "https://pages.git.generalassemb.ly/modular-curriculum-all-courses/universal-resources-internal/static/v2/pkl/template.pkl"

import "microlessons.pkl" as mls

// See:
// https://git.generalassemb.ly/modular-curriculum-all-courses/universal-resources-internal/blob/main/static/v2/pkl/template.pkl
// for the full configuration options available here.

// After modifying this file, use this command while in the root directory
// for this project to create the final configuration file (config.json):
// pkl eval -f json ./internal-resources/data/config.pkl -o %{moduleDir}/%{moduleName}.%{outputFormat}

repo {
  // This name is shown in the header nav to navigate users home
  friendlyName = "Intro to the CLI"
  // This must match the repo name as it appears on GitHub exactly
  name = "intro-to-the-cli"
  type = "Lesson"
}

courses {
  new {
    name = "fallback"
    microlessons {
      // add microlessons here, in the order they should be delivered
      mls.concepts
      mls.fundamentals
      mls.theFileSystem
      mls.navigatingTheFileSystem
      mls.manipulatingTheFileSystem
      mls.theShell
      mls.whatIsACommand
      mls.theManCommand
      mls.flags
    }
  }
  new {
    name = "fws"
    microlessons {
      // add microlessons here, in the order they should be delivered
      mls.concepts
      mls.fundamentals
      mls.theFileSystem
      mls.navigatingTheFileSystem
      mls.manipulatingTheFileSystem
      (mls.theShell) {
        type = "Level Up content"
      }
      (mls.whatIsACommand) {
        type = "Level Up content"
      }
      (mls.theManCommand) {
        type = "Level Up content"
      }
      (mls.flags) {
        type = "Level Up content"
      }
    }
  }
  new {
    name = "seb"
    microlessons {
      mls.concepts
      mls.fundamentals
      mls.theFileSystem
      mls.navigatingTheFileSystem
      mls.manipulatingTheFileSystem
      (mls.theShell) {
        type = "Level Up content"
      }
      (mls.whatIsACommand) {
        type = "Level Up content"
      }
      (mls.theManCommand) {
        type = "Level Up content"
      }
      (mls.flags) {
        type = "Level Up content"
      }
    }
  }
  new {
    name = "itb"
    microlessons {
      mls.concepts
      mls.fundamentals
      mls.theFileSystem
      mls.navigatingTheFileSystem
      mls.manipulatingTheFileSystem
      (mls.theShell) {
        type = "Level Up content"
      }
      (mls.whatIsACommand) {
        type = "Level Up content"
      }
      (mls.theManCommand) {
        type = "Level Up content"
      }
      (mls.flags) {
        type = "Level Up content"
      }
    }
  }
  new {
    name = "its"
    microlessons {
      mls.concepts
      mls.fundamentals
      mls.theFileSystem
      mls.navigatingTheFileSystem
      mls.manipulatingTheFileSystem
      (mls.theShell) {
        type = "Level Up content"
      }
      (mls.whatIsACommand) {
        type = "Level Up content"
      }
      (mls.theManCommand) {
        type = "Level Up content"
      }
      (mls.flags) {
        type = "Level Up content"
      }
    }
  }
}

